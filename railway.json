{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node -e \"console.log('TESTE_RAILWAY_OK');var h=require('http');h.createServer((q,s)=>{s.end('BOT_ON_RAILWAY')}).listen(3000,()=>console.log('PORT_3000_ABERTA'))\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
